# ForgeAI model backend.
# Every stage of the factory runs on ONE small open model. Pick a provider below.

# --- Option A: any OpenAI-compatible endpoint serving an open model ---
FORGEAI_PROVIDER=openai
FORGEAI_BASE_URL=https://api.groq.com/openai/v1
FORGEAI_MODEL=llama-3.1-8b-instant
FORGEAI_API_KEY=

# Other known-good combinations:
#   Together   FORGEAI_BASE_URL=https://api.together.xyz/v1       FORGEAI_MODEL=meta-llama/Meta-Llama-3.1-8B-Instruct-Turbo
#   OpenRouter FORGEAI_BASE_URL=https://openrouter.ai/api/v1      FORGEAI_MODEL=qwen/qwen-2.5-7b-instruct

# --- Option B: local Ollama ---
# FORGEAI_PROVIDER=ollama
# FORGEAI_BASE_URL=http://localhost:11434
# FORGEAI_MODEL=qwen2.5:7b-instruct

# --- Option C: no model at all (deterministic fallback engine, for CI/smoke tests) ---
# FORGEAI_PROVIDER=heuristic

# Budget enforcement (stretch goal)
FORGEAI_MAX_TOKENS=400000
FORGEAI_MAX_SECONDS=1800
